{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "50 7 * * *"
    },
    {
      "path": "/api/digest?send=1",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/recheck",
      "schedule": "0 5 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/(tracker|tracker.html|pm.js|collect.js|history.js|events.js|world-map.js|login|login.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
